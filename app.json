{
  "expo": {
    "name": "MatchDay",
    "slug": "matchday-v3",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "matchday",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#16a34a"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCC5Cme6s4EQBadO-raF1NVDciW0HJwrL4"
        }
      },
      "package": "com.matchday.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyCC5Cme6s4EQBadO-raF1NVDciW0HJwrL4"
      },
      "bundleIdentifier": "com.matchday.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "MatchDay needs your location to show venues and players near you."
        }
      ],
      "expo-web-browser",
      "expo-video",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#16a34a"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9fc1c7c7-af97-4887-a623-6f9c13d2b077"
      }
    },
    "owner": "aneeq101"
  }
}
